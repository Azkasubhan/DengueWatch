{
  "name": "denguewatch",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:live": "RUN_LIVE_AUTH=true node --env-file=.env.local node_modules/@playwright/test/cli.js test e2e/live-auth.spec.ts --workers=1",
    "test:e2e:reports": "RUN_LIVE_REPORTS=true node --env-file=.env.local node_modules/@playwright/test/cli.js test e2e/reports.spec.ts --workers=1",
    "test:e2e:ai": "RUN_M4_DETERMINISTIC=true AI_TEST_ADAPTER=deterministic node --env-file=.env.local node_modules/@playwright/test/cli.js test e2e/ai.spec.ts --workers=1",
    "test:e2e:ai:live": "env -u AI_TEST_ADAPTER RUN_LIVE_GEMINI=true node --env-file=.env.local node_modules/@playwright/test/cli.js test e2e/ai-live.spec.ts --workers=1",
    "test:e2e:m5": "RUN_LIVE_M5=true AI_TEST_ADAPTER=deterministic node --env-file=.env.local node_modules/@playwright/test/cli.js test e2e/verification.spec.ts --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status -o env",
    "supabase:reset": "supabase db reset",
    "test:db": "supabase test db",
    "seed:demo": "node --env-file=.env.local scripts/seed-demo.mjs",
    "seed:reports": "node --env-file=.env.local scripts/seed-report-demo.mjs",
    "cleanup:report-uploads": "node --env-file=.env.local scripts/cleanup-report-uploads.mjs",
    "cleanup:ai-analyses": "node --env-file=.env.local scripts/cleanup-ai-analyses.mjs",
    "test:auth:live": "node --env-file=.env.local scripts/verify-m2-live.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@google/genai": "2.32.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.65.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.21.0"
}
