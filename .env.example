# Safe-to-expose Supabase project settings. RLS remains mandatory.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Canonical application origin used in authentication email redirects.
APP_BASE_URL=http://localhost:3000

# Development seed only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me
ALLOW_DEMO_SEED=false
DEMO_ACCOUNT_PASSWORD=replace_with_a_local_demo_password

# Marks synthetic data in the UI. This is public configuration.
NEXT_PUBLIC_DEMO_MODE=true

