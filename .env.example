# Safe-to-expose Supabase project settings. RLS remains mandatory.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Canonical application origin used in authentication email redirects.
APP_BASE_URL=http://localhost:3000

# Server-only runtime secret, required by the production server (VPS app.env):
# report photo and task-evidence uploads, upload release, and AI analysis use it.
# Also used by local seed/cleanup scripts. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me
ALLOW_DEMO_SEED=false
DEMO_ACCOUNT_PASSWORD=replace_with_a_local_demo_password

# Marks synthetic data in the UI. This is public configuration.
NEXT_PUBLIC_DEMO_MODE=true

# Server-only Gemini SmartSpot. Confirm model availability and quota for your project.
GEMINI_API_KEY=replace_with_development_gemini_key
GEMINI_MODEL=select_supported_image_and_json_model
AI_REQUEST_TIMEOUT_MS=15000

